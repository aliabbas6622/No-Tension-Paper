{
  "entities": {
    "ExamPaper": {
      "title": "ExamPaper",
      "description": "Represents an assessment examination paper with sections, headers, and questions.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the paper."
        },
        "userId": {
          "type": "string",
          "description": "Owner user ID."
        },
        "title": {
          "type": "string",
          "description": "Title of the exam paper."
        },
        "classGrade": {
          "type": "string",
          "description": "Class or grade level (e.g. Class 11, Class 9)."
        },
        "subjectCategory": {
          "type": "string",
          "description": "Subject category like Math, Science, History, Computer Science."
        },
        "header": {
          "type": "object",
          "description": "Header details including examination title, month, group, subject, date, marks."
        },
        "sections": {
          "type": "array",
          "description": "Array of examination sections with questions."
        },
        "settings": {
          "type": "object",
          "description": "Paper display and print visibility settings."
        },
        "curriculumData": {
          "type": "object",
          "description": "Imported curriculum answers payload with units, pages, and answer keys."
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp when paper was created."
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp when paper was updated."
        }
      },
      "required": ["id", "userId", "title", "header", "sections"]
    },
    "SubjectTemplate": {
      "title": "SubjectTemplate",
      "description": "Represents a reusable subject template layout.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the template."
        },
        "userId": {
          "type": "string",
          "description": "Owner user ID."
        },
        "name": {
          "type": "string",
          "description": "Name of the template."
        },
        "subject": {
          "type": "string",
          "description": "Subject title."
        },
        "classGrade": {
          "type": "string",
          "description": "Class or grade level."
        },
        "group": {
          "type": "string",
          "description": "Academic stream or group."
        },
        "category": {
          "type": "string",
          "description": "Subject category."
        },
        "description": {
          "type": "string",
          "description": "Brief description of the template."
        },
        "paper": {
          "type": "object",
          "description": "Full paper structure."
        },
        "curriculumData": {
          "type": "object",
          "description": "Source curriculum answers payload."
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp when created."
        }
      },
      "required": ["id", "userId", "name", "paper"]
    },
    "CurriculumSubject": {
      "title": "CurriculumSubject",
      "description": "Represents a subject with imported curriculum units, questions, and model answers.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for curriculum subject."
        },
        "userId": {
          "type": "string",
          "description": "Creator user id or system."
        },
        "classGrade": {
          "type": "string",
          "description": "Class or grade level."
        },
        "subjectName": {
          "type": "string",
          "description": "Subject name."
        },
        "group": {
          "type": "string",
          "description": "Academic stream/group."
        },
        "category": {
          "type": "string",
          "description": "Subject category."
        },
        "curriculumAnswers": {
          "type": "array",
          "description": "Array of curriculum units with sections, questions, and answers."
        },
        "paperId": {
          "type": "string",
          "description": "Linked generated exam paper ID."
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "description": "Update timestamp."
        }
      },
      "required": ["id", "classGrade", "subjectName", "curriculumAnswers"]
    },
    "ScheduledEmailJob": {
      "title": "ScheduledEmailJob",
      "description": "Represents a Gmail scheduled delivery job for an examination paper.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "senderEmail": { "type": "string", "maxLength": 320 },
        "to": { "type": "string", "maxLength": 1000 },
        "cc": { "type": "string", "maxLength": 1000 },
        "subject": { "type": "string", "maxLength": 500 },
        "messageBody": { "type": "string", "maxLength": 20000 },
        "includePaperText": { "type": "boolean" },
        "attachmentFormat": {
          "type": "string",
          "enum": ["pdf", "docx", "json", "none"]
        },
        "driveShareLink": { "type": "string", "maxLength": 2000 },
        "scheduledFor": { "type": "string", "maxLength": 64 },
        "status": {
          "type": "string",
          "enum": ["pending", "sending", "sent", "failed", "cancelled"]
        },
        "paperId": { "type": "string", "maxLength": 128 },
        "paperTitle": { "type": "string", "maxLength": 500 },
        "paperSnapshot": { "type": "object" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "sentAt": { "type": "string", "maxLength": 64 },
        "gmailMessageId": { "type": "string", "maxLength": 256 },
        "errorMessage": { "type": "string", "maxLength": 1000 }
      },
      "required": [
        "id",
        "userId",
        "to",
        "subject",
        "messageBody",
        "includePaperText",
        "attachmentFormat",
        "scheduledFor",
        "status",
        "paperId",
        "paperTitle",
        "paperSnapshot",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/exam_papers/{paperId}": {
      "schema": {
        "$ref": "#/entities/ExamPaper"
      },
      "description": "Collection of created exam papers authored by users."
    },
    "/custom_templates/{templateId}": {
      "schema": {
        "$ref": "#/entities/SubjectTemplate"
      },
      "description": "Collection of custom subject templates."
    },
    "/curriculum_subjects/{subjectId}": {
      "schema": {
        "$ref": "#/entities/CurriculumSubject"
      },
      "description": "Collection of curriculum subjects imported with units, questions and answer keys."
    },
    "/scheduled_emails/{jobId}": {
      "schema": {
        "$ref": "#/entities/ScheduledEmailJob"
      },
      "description": "Collection of scheduled Gmail deliveries authored by signed-in users."
    }
  }
}
